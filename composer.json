{
    "name": "vlastimilvasek/livewire-advanced-media-library",
    "description": "A reusable Livewire image gallery manager for Spatie Media Library.",
    "type": "library",
    "version": "0.1.0",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "VlastimilVasek\\LivewireAdvancedMediaLibrary\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "VlastimilVasek\\LivewireAdvancedMediaLibrary\\LivewireAdvancedMediaLibraryServiceProvider"
            ]
        }
    },
    "require": {
        "php": "^8.3",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "livewire/livewire": "^3.0|^4.0",
        "spatie/laravel-medialibrary": "^11.0",
        "spatie/image": "^3.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^11.0|^12.0"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
